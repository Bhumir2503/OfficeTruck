# Copy to .env.local. Both values are in the Supabase dashboard under
# Project Settings > API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Invitation emails are sent with Resend (https://resend.com/api-keys).
# Until you verify a domain in Resend, it only delivers to your own address.
RESEND_API_KEY=
# A sender on your verified domain, e.g. OfficeTruck <invites@mydomain.com>.
RESEND_FROM_EMAIL=
# The app's public address, used for links in emails, e.g. https://app.mydomain.com
APP_URL=

# FMCSA broker checks. These stay on the server, never NEXT_PUBLIC_.
# App token for the DOT open data API, which serves FMCSA's carrier and broker
# records ("Carrier - All With History"). Create one at
# https://data.transportation.gov/profile/edit/developer_settings.
DOT_DATA_APP_TOKEN=
# The dataset's query endpoint. Leave as is unless DOT moves it.
DOT_DATA_URL=https://data.transportation.gov/api/v3/views/6eyk-hxee/query.json
# Optional fallback: WebKey for the FMCSA QCMobile API
# (https://mobile.fmcsa.dot.gov/QCDevsite/), used only when
# DOT_DATA_APP_TOKEN is empty.
FMCSA_WEB_KEY=
# Supabase secret key (Project Settings > API Keys), used only to write the
# shared fmcsa_records table.
SUPABASE_SECRET_KEY=

# Reads rate cons on New Load with Claude (https://platform.claude.com/settings/keys).
# Stays on the server, never NEXT_PUBLIC_. Only the rate con file is sent.
ANTHROPIC_API_KEY=

# Works out loaded miles from a load's stops with the Google Maps Routes API
# (https://console.cloud.google.com/google/maps-apis/credentials, with the
# Routes API turned on). Stays on the server, never NEXT_PUBLIC_. Only the
# stop addresses are sent.
GOOGLE_MAPS_API_KEY=

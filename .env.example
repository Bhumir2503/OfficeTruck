# Copy to .env.local. Both values are in the Supabase dashboard under
# Project Settings > API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Invitation emails are sent with Resend (https://resend.com/api-keys).
# Until you verify a domain in Resend, it only delivers to your own address.
RESEND_API_KEY=
# A sender on your verified domain, e.g. OfficeTruck <invites@mydomain.com>.
RESEND_FROM_EMAIL=
# The app's public address, used for links in emails, e.g. https://app.mydomain.com
APP_URL=
